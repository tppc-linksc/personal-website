# ========================
# 必填：管理员登录密码
# 登录 /studio/login 时输入
# ========================
STUDIO_ADMIN_TOKEN=

# 可选：管理员名称（留言显示的作者标识）
STUDIO_OWNER_NAME=Author

# 可选：会话有效期（秒），默认 3 天
STUDIO_SESSION_TTL_SECONDS=259200

# ========================
# 以下两项为高级配置，不填也行，会自动用 STUDIO_ADMIN_TOKEN 代替
# ========================
# 可选：会话 cookie 加密密钥（不填会用 STUDIO_ADMIN_TOKEN 代替）
STUDIO_SESSION_SECRET=
# 可选：密码哈希版（填了就不用填 STUDIO_ADMIN_TOKEN，服务器存密文更安全）
STUDIO_ADMIN_TOKEN_HASH=

# ========================
# GitHub Stars 获取（可选）
# ========================
# GitHub 个人访问令牌，用于获取项目 star 数（提高 API 限额）
GITHUB_TOKEN=
# Stars 缓存有效期（毫秒），默认 30 分钟
GITHUB_STARS_CACHE_TTL_MS=1800000
# GitHub API 请求超时（毫秒），默认 2.5 秒
GITHUB_STARS_TIMEOUT_MS=2500
